import React, { useEffect, useState } from 'react';

const IMAGE = '/assets/images/DoorPink.jpg';
const OPEN_MS = 6000;
const SEEN_KEY = 'lr_seen_door';

export const DoorIntro: React.FC = () => {
  const [visible, setVisible] = useState(true);
  const [opening, setOpening] = useState(false);

  useEffect(() => {
    try {
      if (sessionStorage.getItem(SEEN_KEY)) setVisible(false);
    } catch {
      /* storage blocked: show the door */
    }
  }, []);

  useEffect(() => {
    if (!visible) return;
    const prev = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    return () => {
      document.body.style.overflow = prev;
    };
  }, [visible]);

  const handleOpen = () => {
    if (opening) return;
    setOpening(true);
    try {
      sessionStorage.setItem(SEEN_KEY, '1');
    } catch {
      /* ignore */
    }
    window.setTimeout(() => setVisible(false), OPEN_MS + 100);
  };

  if (!visible) return null;

  const ease = `transform ${OPEN_MS}ms cubic-bezier(0.4, 0, 0.6, 1)`;

  const halfBase: React.CSSProperties = {
    position: 'absolute',
    top: 0,
    bottom: 0,
    width: '50%',
    overflow: 'hidden',
    backfaceVisibility: 'hidden',
    transition: ease,
    willChange: 'transform',
    background: '#111',
  };

  const imageBase: React.CSSProperties = {
    position: 'absolute',
    top: 0,
    width: '100vw',
    height: '100%',
    maxWidth: 'none',
    objectFit: 'cover',
    objectPosition: 'center',
  };

  return (
    <div
      className="fixed inset-0 z-[9999]"
      style={{ perspective: '1600px', pointerEvents: opening ? 'none' : 'auto' }}
      role="dialog"
      aria-label="Welcome door"
    >
      <div
        style={{
          ...halfBase,
          left: 0,
          transformOrigin: 'left center',
          transform: opening ? 'rotateY(-75deg)' : 'rotateY(0deg)',
          boxShadow: '8px 0 30px rgba(0,0,0,0.35)',
        }}
      >
        <img src={IMAGE} alt="" style={{ ...imageBase, left: 0 }} draggable={false} />
      </div>

      <div
        style={{
          ...halfBase,
          right: 0,
          transformOrigin: 'right center',
          transform: opening ? 'rotateY(75deg)' : 'rotateY(0deg)',
          boxShadow: '-8px 0 30px rgba(0,0,0,0.35)',
        }}
      >
        <img src={IMAGE} alt="" style={{ ...imageBase, right: 0 }} draggable={false} />
      </div>

      <div
        className="absolute inset-x-0 bottom-[8vh] flex justify-center px-4"
        style={{ opacity: opening ? 0 : 1, transition: 'opacity 300ms ease' }}
      >
        <button
          onClick={handleOpen}
          className="rounded-full bg-white/90 px-8 py-3 text-sm font-medium text-neutral-900 shadow-lg backdrop-blur transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#c9a86a]"
        >
          Open the door
        </button>
      </div>
    </div>
  );
};

export default DoorIntro;





