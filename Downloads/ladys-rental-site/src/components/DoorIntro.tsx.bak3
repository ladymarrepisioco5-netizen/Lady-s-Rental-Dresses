import React, { useEffect, useState } from 'react';

const IMAGE = '/assets/images/DoorPink.jpg';
// Bilis ng pagbukas sa milliseconds. Dagdagan para mas mabagal (hal. 8000).
const OPEN_MS = 6000;
const EASE = 'cubic-bezier(0.4, 0, 0.6, 1)';
// Gaano kalawak bumukas ang pinto (degrees).
const ANGLE = 80;

export const DoorIntro: React.FC = () => {
  const [visible, setVisible] = useState(true);
  const [opening, setOpening] = useState(false);

  useEffect(() => {
    if (!visible) return;
    const prev = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    return () => {
      document.body.style.overflow = prev;
    };
  }, [visible]);

  const handleOpen = () => {
    if (opening) return;
    setOpening(true);
    window.setTimeout(() => setVisible(false), OPEN_MS + 300);
  };

  if (!visible) return null;

  const leaf = (side: 'left' | 'right'): React.CSSProperties => ({
    position: 'absolute',
    top: 0,
    bottom: 0,
    [side]: 0,
    width: '50%',
    overflow: 'hidden',
    transformOrigin: side === 'left' ? 'left center' : 'right center',
    transform: opening
      ? `rotateY(${side === 'left' ? ANGLE : -ANGLE}deg)`
      : 'rotateY(0deg)',
    transition: `transform ${OPEN_MS}ms ${EASE}`,
    willChange: 'transform',
    backgroundColor: '#e48fb4',
    boxShadow: opening
      ? 'inset 0 0 120px rgba(0,0,0,0.35)'
      : 'inset 0 0 0 rgba(0,0,0,0)',
  });

  const pic = (side: 'left' | 'right'): React.CSSProperties => ({
    position: 'absolute',
    top: 0,
    [side]: 0,
    width: '100vw',
    height: '100%',
    backgroundImage: `url(${IMAGE})`,
    backgroundSize: 'cover',
    backgroundPosition: 'center',
    backgroundRepeat: 'no-repeat',
  });

  return (
    <div
      className="fixed inset-0 z-[9999]"
      style={{ perspective: '1800px', pointerEvents: opening ? 'none' : 'auto' }}
      role="dialog"
      aria-label="Welcome door"
    >
      <div style={leaf('left')}>
        <div style={pic('left')} />
      </div>
      <div style={leaf('right')}>
        <div style={pic('right')} />
      </div>

      <div
        className="absolute inset-x-0 flex flex-col items-center gap-6"
        style={{
          bottom: '10vh',
          opacity: opening ? 0 : 1,
          transition: 'opacity 400ms ease',
        }}
      >
        <p className="text-xs uppercase tracking-[0.35em] text-white/90 drop-shadow-lg">
          Lady&rsquo;s Rental
        </p>
        <button
          onClick={handleOpen}
          className="rounded-full bg-white/90 px-8 py-3 text-sm font-medium text-neutral-900 shadow-lg backdrop-blur transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#c9a86a]"
        >
          Explore Collection
        </button>
      </div>
    </div>
  );
};

export default DoorIntro;
