import React, { useEffect, useState } from 'react';

const IMAGE = '/assets/images/DoorPink.jpg';
// Hugis ng pinto (lapad / taas). Ayusin kung mukhang naka-stretch ang larawan.
const DOOR_ASPECT = '3 / 5';
// Bilis ng pagbukas sa milliseconds. Dagdagan para mas mabagal.
const OPEN_MS = 6000;
const EASE = 'cubic-bezier(0.4, 0, 0.6, 1)';

export const DoorIntro: React.FC = () => {
  const [visible, setVisible] = useState(true);
  const [opening, setOpening] = useState(false);

  useEffect(() => {
    if (!visible) return;
    const prev = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    return () => {
      document.body.style.overflow = prev;
    };
  }, [visible]);

  const handleOpen = () => {
    if (opening) return;
    setOpening(true);
    window.setTimeout(() => setVisible(false), OPEN_MS + 900);
  };

  if (!visible) return null;

  const leaf = (side: 'left' | 'right'): React.CSSProperties => ({
    position: 'absolute',
    top: 0,
    bottom: 0,
    [side]: 0,
    width: '50%',
    transformOrigin: side === 'left' ? 'left center' : 'right center',
    transform: opening
      ? `rotateY(${side === 'left' ? -75 : 75}deg)`
      : 'rotateY(0deg)',
    transition: `transform ${OPEN_MS}ms ${EASE}`,
    backfaceVisibility: 'hidden',
    willChange: 'transform',
    backgroundImage: `url(${IMAGE})`,
    backgroundSize: '200% 100%',
    backgroundPosition: side === 'left' ? 'left center' : 'right center',
    backgroundRepeat: 'no-repeat',
    backgroundColor: '#e48fb4',
    boxShadow: 'inset 0 0 0 1px rgba(255,255,255,0.2), inset 0 -30px 50px rgba(0,0,0,0.18)',
  });

  return (
    <div
      className="fixed inset-0 z-[9999] flex items-center justify-center"
      style={{
        background: 'radial-gradient(ellipse at center, #1c1424 0%, #09090d 70%)',
        opacity: opening ? 0 : 1,
        transition: opening ? `opacity 800ms ease ${OPEN_MS - 300}ms` : undefined,
        pointerEvents: opening ? 'none' : 'auto',
      }}
      role="dialog"
      aria-label="Welcome door"
    >
      <div className="flex flex-col items-center gap-8 px-4">
        <p
          className="text-xs uppercase tracking-[0.35em] text-pink-200/80"
          style={{ opacity: opening ? 0 : 1, transition: 'opacity 500ms ease' }}
        >
          Lady&rsquo;s Rental
        </p>

        <div
          style={{
            width: 'min(62vw, 280px)',
            aspectRatio: DOOR_ASPECT,
            maxHeight: '60vh',
            transform: opening ? 'scale(1.18)' : 'scale(1)',
            transition: `transform ${OPEN_MS}ms ${EASE}`,
          }}
        >
          <div
            style={{
              position: 'relative',
              width: '100%',
              height: '100%',
              padding: 8,
              borderRadius: '50% 50% 6px 6px / 20% 20% 6px 6px',
              background: 'linear-gradient(160deg, #e9d3a1, #c9a86a 50%, #8a6b30)',
              boxShadow: '0 25px 60px rgba(0,0,0,0.6), 0 0 80px rgba(228,143,180,0.15)',
            }}
          >
            <div
              style={{
                position: 'absolute',
                inset: 8,
                borderRadius: '50% 50% 2px 2px / 20% 20% 2px 2px',
                background:
                  'radial-gradient(ellipse at center, #fff6e0 0%, #ffd9ea 45%, #f3b6cf 100%)',
              }}
            />
            <div
              style={{
                position: 'absolute',
                inset: 8,
                perspective: '1400px',
                borderRadius: '50% 50% 2px 2px / 20% 20% 2px 2px',
                overflow: opening ? 'visible' : 'hidden',
              }}
            >
              <div style={leaf('left')} />
              <div style={leaf('right')} />
            </div>
          </div>
        </div>

        <button
          onClick={handleOpen}
          className="rounded-full bg-white/90 px-8 py-3 text-sm font-medium text-neutral-900 shadow-lg backdrop-blur transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#c9a86a]"
          style={{ opacity: opening ? 0 : 1, transition: 'opacity 300ms ease' }}
        >
          Explore Collection
        </button>
      </div>
    </div>
  );
};

export default DoorIntro;
